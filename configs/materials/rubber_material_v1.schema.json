{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rcs_rubber_material_v1",
  "title": "RCS rubber material recipe v1 (ADR 0023 §14.1)",
  "description": "Documentation schema. The authoritative validator is robotic_cutting_sim.rubber_material.parse_recipe, which also enforces the cross-field rules listed in x-rules (tests/test_rubber_material.py checks that both agree on keys).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "calibration_status", "material_identity", "density_kg_m3", "model", "elastic", "viscoelastic", "contact", "numerics", "provenance"],
  "$defs": {
    "ranged": {"type": "object", "additionalProperties": false, "required": ["value", "range"],
               "properties": {"value": {"type": "number", "exclusiveMinimum": 0},
                              "range": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2}}}
  },
  "properties": {
    "schema": {"const": "rcs_rubber_material_v1"},
    "id": {"type": "string", "minLength": 1},
    "calibration_status": {"enum": ["SIMULATOR_ONLY_UNCALIBRATED", "PILOT_FIT_NOT_HELDOUT", "REAL_CALIBRATED"]},
    "material_identity": {"type": "object", "additionalProperties": false, "required": ["family", "candidates", "evidence"],
                          "properties": {"family": {"type": "string"}, "candidates": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string"}}},
    "density_kg_m3": {"$ref": "#/$defs/ranged"},
    "model": {"enum": ["neo_hookean_jbar_v1", "neo_hookean_jbar_prony_v1"]},
    "elastic": {"type": "object", "additionalProperties": false,
                "required": ["shear_modulus_eq_pa", "bulk_ratio_numerical", "bulk_modulus_physical_pa"],
                "properties": {"shear_modulus_eq_pa": {"$ref": "#/$defs/ranged"},
                               "bulk_ratio_numerical": {"$ref": "#/$defs/ranged"},
                               "bulk_modulus_physical_pa": {"type": "object", "additionalProperties": false, "required": ["value", "status"],
                                                            "properties": {"value": {"type": "number", "exclusiveMinimum": 0},
                                                                           "status": {"enum": ["LITERATURE_TYPICAL_UNMEASURED", "MEASURED"]}}}}},
    "viscoelastic": {"type": "object", "additionalProperties": false, "required": ["applies_to", "max_terms", "prony"],
                     "properties": {"applies_to": {"const": "isochoric"}, "max_terms": {"const": 4},
                                    "prony": {"type": "array", "maxItems": 4,
                                              "items": {"type": "object", "additionalProperties": false, "required": ["g", "tau_s"],
                                                        "properties": {"g": {"type": "number", "minimum": 0}, "tau_s": {"type": "number", "exclusiveMinimum": 0}}}}}},
    "contact": {"type": "object", "additionalProperties": false, "required": ["friction_table", "friction_pad", "friction_self"],
                "properties": {"friction_table": {"$ref": "#/$defs/ranged"}, "friction_pad": {"$ref": "#/$defs/ranged"}, "friction_self": {"$ref": "#/$defs/ranged"}}},
    "numerics": {"type": "object", "additionalProperties": false,
                 "required": ["resolution_profile", "particles_per_cell_axis", "min_cells_through_thickness", "cfl", "pic", "contact_stiffness_fraction", "self_contact_stiffness_fraction", "contact_radius_scale", "j_domain", "j_physical_tolerance"],
                 "properties": {"resolution_profile": {"enum": ["rubber_ref_v1", "rubber_rl_v1", "rubber_coarse_v1"]},
                                "particles_per_cell_axis": {"const": 2}, "min_cells_through_thickness": {"enum": [2, 3, 4]},
                                "cfl": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5}, "pic": {"const": 0},
                                "contact_stiffness_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                                "self_contact_stiffness_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                                "contact_radius_scale": {"type": "number", "exclusiveMinimum": 0},
                                "j_domain": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                                "j_physical_tolerance": {"type": "number", "exclusiveMinimum": 0}}},
    "derived": {"type": "string", "description": "note only; derived values are never input"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["defined", "values"],
                   "properties": {"defined": {"type": "string"}, "values": {"type": "string"}}},
    "calibration_manifest": {"type": ["string", "null"]},
    "heldout_verdict": {"enum": ["PASS", "FAIL", "NOT_RUN", null]}
  },
  "x-rules": [
    "every ranged value lies inside its range",
    "sum of Prony g_i < 1, g_i >= 0, tau_i > 0, at most 4 terms",
    "model is neo_hookean_jbar_prony_v1 iff prony is non-empty",
    "poisson_ratio, nu, young_modulus_pa, lame_lambda, bulk_modulus_pa are refused input keys at every level",
    "pic must be 0 (pure FLIP)",
    "REAL_CALIBRATED requires calibration_manifest naming a FROZEN_FOR_HELDOUT manifest and heldout_verdict PASS",
    "particles_per_cell_axis and min_cells_through_thickness must equal the resolution profile's values"
  ]
}
